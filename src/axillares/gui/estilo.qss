/*
 * Axillares — folha de estilo (linguagem Phareon).
 * Os tokens ($$nome entre chaves) vêm de gui/tema.py. Para substituir esta folha, copie-a para
 * ~/.config/axillares/estilo.qss e edite. Fontes NÃO são definidas aqui: ficam em
 * tema.fonte(Papel), porque QSS não tem letter-spacing e sobrescreveria setFont().
 */

QWidget { color: ${tinta}; selection-background-color: ${acento}; selection-color: ${sobre_acento}; }
QMainWindow, #raiz { background: ${fundo}; }

/* ---- trilho de navegação ---------------------------------------------------------------- */
#trilho { background: ${fundo}; border-right: 1px solid ${linha}; }
#trilho QLabel[tom="3"] { color: ${tinta_3}; }

QPushButton[tipo="nav"] {
    background: transparent; border: none; border-left: 2px solid transparent;
    color: ${tinta_2}; text-align: left; padding: 10px 14px 10px 18px;
}
QPushButton[tipo="nav"]:hover { color: ${tinta}; background: ${fundo_2}; }
QPushButton[tipo="nav"]:checked { color: ${tinta}; border-left: 2px solid ${acento}; background: ${fundo_2}; }
QPushButton[tipo="nav"]:disabled { color: ${tinta_3}; }
QPushButton[tipo="nav"]:focus { outline: none; }

QPushButton[tipo="segmento"] {
    background: transparent; border: 1px solid ${linha}; color: ${tinta_2};
    padding: 6px 4px; border-radius: 0px;
}
QPushButton[tipo="segmento"][posicao="inicio"] { border-top-left-radius: ${raio_s}px; border-bottom-left-radius: ${raio_s}px; }
QPushButton[tipo="segmento"][posicao="fim"] { border-top-right-radius: ${raio_s}px; border-bottom-right-radius: ${raio_s}px; }
QPushButton[tipo="segmento"]:hover { color: ${tinta}; border-color: ${linha_forte}; }
QPushButton[tipo="segmento"]:checked { background: ${fundo_3}; color: ${tinta}; border-color: ${linha_forte}; }

/* ---- botões ----------------------------------------------------------------------------- */
QPushButton[tipo="primario"] {
    background: ${acento}; color: ${sobre_acento}; border: 1px solid ${acento};
    border-radius: 22px; padding: 12px 24px; min-height: 18px;
}
QPushButton[tipo="primario"]:hover { background: ${acento_brilho}; border-color: ${acento_brilho}; }
QPushButton[tipo="primario"]:pressed { background: ${acento}; }
QPushButton[tipo="primario"]:disabled { background: ${fundo_3}; border-color: ${linha}; color: ${tinta_3}; }
QPushButton[tipo="primario"]:focus { border: 2px solid ${tinta}; }

QPushButton[tipo="fantasma"] {
    background: transparent; color: ${tinta}; border: 1px solid ${linha_forte};
    border-radius: 22px; padding: 12px 24px; min-height: 18px;
}
QPushButton[tipo="fantasma"]:hover { background: ${tinta}; color: ${fundo}; border-color: ${tinta}; }
QPushButton[tipo="fantasma"]:disabled { color: ${tinta_3}; border-color: ${linha}; }
QPushButton[tipo="fantasma"]:focus { border: 2px solid ${acento}; }

QPushButton[tipo="link"] {
    background: transparent; border: none; color: ${tinta_2}; padding: 2px 0; text-align: left;
}
QPushButton[tipo="link"]:hover { color: ${acento}; }

/* ---- tinta ------------------------------------------------------------------------------ */
QLabel { background: transparent; }
QLabel[tom="2"] { color: ${tinta_2}; }
QLabel[tom="3"] { color: ${tinta_3}; }
QLabel[tom="acento"] { color: ${acento}; }
QLabel[tom="ok"] { color: ${ok}; }
QLabel[tom="falha"] { color: ${falha}; }
QLabel[tom="aviso"] { color: ${aviso}; }

/* ---- superfícies ------------------------------------------------------------------------ */
QFrame[tipo="grade"] { background: ${linha}; border: 1px solid ${linha}; }
QFrame[tipo="celula"] { background: ${fundo}; }
QFrame[tipo="celula"]:hover { background: ${fundo_3}; }
QFrame[tipo="cartao"] { background: ${fundo_2}; border: 1px solid ${linha}; border-radius: ${raio_l}px; }
QFrame[tipo="tabela"] { background: transparent; border-top: 1px solid ${linha_forte}; }
QFrame[tipo="linha-tabela"] { background: transparent; border-bottom: 1px solid ${linha}; }
QFrame[tipo="linha-tabela"]:hover { background: ${fundo_2}; }
QFrame[tipo="regua"] { background: ${linha}; border: none; max-height: 1px; min-height: 1px; }
QFrame[tipo="faixa-progresso"] { background: ${fundo_2}; border-top: 1px solid ${linha}; }

QPlainTextEdit[tipo="log"] {
    background: ${fundo}; color: ${tinta_2}; border: 1px solid ${linha}; border-radius: ${raio_s}px;
    padding: 8px;
}

/* ---- rolagem e progresso ---------------------------------------------------------------- */
QScrollArea, QScrollArea > QWidget > QWidget { background: transparent; border: none; }
QScrollBar:vertical { background: transparent; width: 10px; margin: 2px; }
QScrollBar::handle:vertical { background: ${linha_forte}; border-radius: 3px; min-height: 40px; }
QScrollBar::handle:vertical:hover { background: ${tinta_3}; }
QScrollBar::add-line, QScrollBar::sub-line, QScrollBar::add-page, QScrollBar::sub-page { background: none; height: 0; }

QProgressBar { background: ${linha}; border: none; border-radius: 1px; max-height: 2px; min-height: 2px; }
QProgressBar::chunk { background: ${acento}; border-radius: 1px; }

QToolTip {
    background: ${fundo_3}; color: ${tinta}; border: 1px solid ${linha_forte};
    padding: 6px 8px; font-family: "${fam_corpo}"; font-size: 12px;
}

/* ---- campos ----------------------------------------------------------------------------- */
QDialog { background: ${fundo}; }
QLineEdit {
    background: ${fundo_2}; color: ${tinta}; border: 1px solid ${linha_forte};
    border-radius: ${raio_s}px; padding: 9px 12px; selection-background-color: ${acento};
}
QLineEdit:focus { border: 1px solid ${acento}; }
QLineEdit[erro="sim"] { border: 1px solid ${falha}; }

QComboBox {
    background: ${fundo_2}; color: ${tinta}; border: 1px solid ${linha_forte};
    border-radius: ${raio_s}px; padding: 8px 12px; min-width: 120px;
}
QComboBox:hover { border-color: ${tinta_3}; }
QComboBox:focus { border-color: ${acento}; }
QComboBox::drop-down { border: none; width: 24px; }
QComboBox QAbstractItemView {
    background: ${fundo_2}; color: ${tinta}; border: 1px solid ${linha_forte};
    selection-background-color: ${fundo_3}; selection-color: ${tinta}; outline: none; padding: 4px;
}

QCheckBox { spacing: 8px; color: ${tinta_2}; }
QCheckBox::indicator {
    width: 14px; height: 14px; border: 1px solid ${linha_forte}; border-radius: 3px;
    background: transparent;
}
QCheckBox::indicator:hover { border-color: ${tinta_2}; }
QCheckBox::indicator:checked { background: ${acento}; border-color: ${acento}; }

QFrame[tipo="linha-tabela"][selecionavel="sim"]:hover { background: ${fundo_2}; }
QFrame[tipo="painel-execucao"] {
    background: ${fundo_2}; border: 1px solid ${linha}; border-left: 2px solid ${acento};
    border-radius: ${raio_s}px;
}
QFrame[tipo="cartao-etapa"] { background: ${fundo}; }
QFrame[tipo="cartao-etapa"]:hover { background: ${fundo_3}; }

/* ---- editor ----------------------------------------------------------------------------- */
QFrame[tipo="lateral-editor"] { background: ${fundo}; border-right: 1px solid ${linha}; }
QTreeWidget { background: transparent; border: none; outline: none; padding: 4px 6px; }
QTreeWidget::item { padding: 5px 6px; border-radius: ${raio_s}px; }
QTreeWidget::item:hover { background: ${fundo_2}; }
QTreeWidget::item:selected { background: ${fundo_3}; color: ${tinta}; }
QTreeWidget::branch { background: transparent; image: none; border: none; }
QSplitter::handle { background: ${linha}; }

QFrame[tipo="barra-abas"] { background: ${fundo}; border-bottom: 1px solid ${linha}; }
QFrame[tipo="aba"] { background: transparent; border-right: 1px solid ${linha}; border-top: 2px solid transparent; }
QFrame[tipo="aba"]:hover { background: ${fundo_2}; }
QFrame[tipo="aba"][ativa="sim"] { background: ${fundo_2}; border-top: 2px solid ${acento}; }
QPushButton[tipo="fechar-aba"] {
    background: transparent; border: none; color: ${tinta_3}; border-radius: 10px; font-size: 15px;
    padding: 0;
}
QPushButton[tipo="fechar-aba"]:hover { background: ${fundo_3}; color: ${tinta}; }

QPushButton[tipo="compacto"], QPushButton[tipo="compacto-primario"] {
    border-radius: 14px; padding: 5px 14px; min-height: 16px;
}
QPushButton[tipo="compacto"] { background: transparent; color: ${tinta}; border: 1px solid ${linha_forte}; }
QPushButton[tipo="compacto"]:hover { background: ${tinta}; color: ${fundo}; border-color: ${tinta}; }
QPushButton[tipo="compacto-primario"] { background: ${acento}; color: ${sobre_acento}; border: 1px solid ${acento}; }
QPushButton[tipo="compacto-primario"]:hover { background: ${acento_brilho}; border-color: ${acento_brilho}; }
QPushButton[tipo="compacto"]:disabled, QPushButton[tipo="compacto-primario"]:disabled {
    background: transparent; color: ${tinta_3}; border-color: ${linha};
}

QFrame[tipo="barra-estado"] { background: ${fundo}; border-top: 1px solid ${linha}; }
QFrame[tipo="painel-problemas"] { background: ${fundo}; border-top: 1px solid ${linha_forte}; }
