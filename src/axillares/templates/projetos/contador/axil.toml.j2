# Projeto Axillares — {{ nome }}
# Documentação: https://github.com/phareon-corp/axillares

[projeto]
nome = "{{ nome }}"
topo = "contador"
descricao = "Contador síncrono de 8 bits com habilitação — o projeto de exemplo do Axillares."

[fontes]
rtl = ["rtl/**/*.v", "rtl/**/*.sv"]
testbenches = ["tb/**/*.v"]
sdc = "restricoes/contador.sdc"

[asic]
pdk = "{{ pdk }}"          # skywater130 · gf180 · ihp130
frequencia_mhz = {{ frequencia_mhz }}         # usada para gerar o SDC quando fontes.sdc não é informado
relogio = "clk"

[fpga]
placa = "icebreaker"        # icebreaker · ulx3s  (veja: axil placas)

[fpga.pinos.icebreaker]
clk = "clk"
rst_n = "btn0"
en = "btn1"
"q[0]" = "led0"
"q[1]" = "led1"
"q[2]" = "led2"
"q[3]" = "led3"
"q[4]" = "led4"

[fpga.pinos.ulx3s]
clk = "clk"
rst_n = "btn0"
en = "btn1"
"q[0]" = "led0"
"q[1]" = "led1"
"q[2]" = "led2"
"q[3]" = "led3"
"q[4]" = "led4"
"q[5]" = "led5"
"q[6]" = "led6"
"q[7]" = "led7"

[simulacao]
simulador = "icarus"        # icarus · verilator — para o testbench clássico (axil sim)
testbench = "tb_contador"   # módulo de topo do testbench clássico
testes = ["tb/test_*.py"]   # testes cocotb (axil teste)

[motores]
sintese = "siliconcompiler"
gds = "siliconcompiler"
fpga = "edalize"
sim = "edalize"
teste = "edalize"
